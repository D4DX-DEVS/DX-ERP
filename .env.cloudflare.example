# Production configuration for the Cloudflare Worker. Copy to `.env.cloudflare` (git-ignored), fill in, then:
#   npx wrangler secret bulk .env.cloudflare
# The D1 database and R2 buckets are bindings in wrangler.jsonc, not variables.

APP_URL=https://dx-erp.<your-subdomain>.workers.dev
AUTH_SECRET=
CRON_SECRET=

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=
# scrypt hash from `npm run hash-password` (never a plain password in production) + optional TOTP secret
SUPER_ADMIN_PASSWORD_HASH=
SUPER_ADMIN_TOTP_SECRET=

# Google sign-in for staff — add <APP_URL>/api/auth/google/callback as a redirect URI in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=

# Files (R2). PUBLIC_FILES_URL = public URL of the dx-erp-public bucket (r2.dev URL or a custom domain);
# leave empty to serve public files through the app.
PUBLIC_FILES_URL=
FILES_FOLDER=dx-erp

# Must be byte-identical to the current value, or stored vault secrets cannot be decrypted.
VAULT_MASTER_KEY=
VAULT_MASTER_KEY_PREVIOUS=

# Optional email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
