# D4DX ERP — copy to .env.local for local development (`npm run dev` uses a local D1 + R2 in .wrangler/state).
# Production runs on Cloudflare Workers: see .env.cloudflare.example (values become Worker secrets).

APP_URL=
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata
AUTH_SECRET=

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=
# Development only. In production leave this empty and set the scrypt hash instead (npm run hash-password),
# plus a TOTP secret so the admin sign-in needs an authenticator code (base32, e.g. from an authenticator app).
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_PASSWORD_HASH=
SUPER_ADMIN_TOTP_SECRET=

# Files live in R2 (bindings FILES / PUBLIC_FILES in wrangler.jsonc). Optional public base URL of the public bucket;
# empty = public files (avatars, logo) are served through /api/public-files.
PUBLIC_FILES_URL=
FILES_FOLDER=dx-erp

# Google sign-in for staff — redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only allow this Google Workspace domain (e.g. d4dx.co). Set it in production: without it, any Google
# account whose address matches a staff record's work email can sign in as that person.
GOOGLE_ALLOWED_DOMAIN=

# Scheduled jobs — random secret for /api/cron
CRON_SECRET=

# Optional: email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Project secrets vault — 32-byte master key that encrypts every project's secrets key.
# Generate with: openssl rand -hex 32   (keep it out of the database and back it up separately:
# losing it makes stored secrets unrecoverable). To rotate, move the old value to
# VAULT_MASTER_KEY_PREVIOUS and set a new VAULT_MASTER_KEY; keys are re-wrapped on next use.
VAULT_MASTER_KEY=
VAULT_MASTER_KEY_PREVIOUS=
